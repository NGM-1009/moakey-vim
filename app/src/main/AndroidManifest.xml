<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="MainApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        tools:targetApi="33">

        <service
            android:name="OpenMoaIME"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">

            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />

        </service>

        <activity
            android:name="dev.bsb.moakeyvim.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.MoaKeyVim.Settings" />

        <activity
            android:name="dev.bsb.moakeyvim.settings.ShortcutSettingsActivity"
            android:exported="false"
            android:label="@string/settings_shortcut_title"
            android:theme="@style/Theme.MoaKeyVim.Settings" />

        <activity
            android:name="dev.bsb.moakeyvim.settings.PhraseEditActivity"
            android:exported="false"
            android:theme="@style/Theme.MoaKeyVim.QuickPhraseEdit" />

        <activity
            android:name="dev.bsb.moakeyvim.settings.GestureAngleActivity"
            android:exported="false"
            android:label="@string/settings_gesture_angle_title"
            android:theme="@style/Theme.MoaKeyVim.Settings"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="dev.bsb.moakeyvim.settings.HotstringListActivity"
            android:exported="false"
            android:label="@string/settings_hotstring_manage_title"
            android:theme="@style/Theme.MoaKeyVim.Settings" />

        <activity
            android:name="dev.bsb.moakeyvim.settings.LearnedWordsActivity"
            android:exported="false"
            android:label="@string/settings_learned_words_title"
            android:theme="@style/Theme.MoaKeyVim.Settings" />

        <activity
            android:name="dev.bsb.moakeyvim.settings.VimKeymapActivity"
            android:exported="false"
            android:label="@string/vim_help_dialog_title"
            android:theme="@style/Theme.MoaKeyVim.Settings" />

        <activity
            android:name="dev.bsb.moakeyvim.settings.DevToolsActivity"
            android:exported="false"
            android:label="@string/dev_tools_title"
            android:theme="@style/Theme.MoaKeyVim.Settings" />

        <activity
            android:name="dev.bsb.moakeyvim.clipboard.ClipboardEditActivity"
            android:exported="false"
            android:label="@string/clipboard_edit_title"
            android:theme="@style/Theme.MoaKeyVim.Settings" />

    </application>

</manifest>